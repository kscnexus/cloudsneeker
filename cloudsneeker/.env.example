#### Cloudsneeker environment template ####
# Copy next to the compose file you use (cloudsneeker/deploy/.env for the
# product stack, or the repository root for upstream docker-compose files)
# and replace every placeholder. Never commit the resulting `.env`.

#### Images ####
# Registry prefix for the images built by cloudsneeker/deploy/scripts/build.sh.
CLOUDSNEEKER_REGISTRY=cloudsneeker

#### Web app ####
CLOUDSNEEKER_UI_VERSION="stable"
AUTH_URL=https://app.cloudsneeker.example
API_BASE_URL=http://cloudsneeker-api:8080/api/v1
UI_API_BASE_URL=${API_BASE_URL}
UI_API_DOCS_URL=http://cloudsneeker-api:8080/api/v1/docs
AUTH_TRUST_HOST=true
UI_PORT=3000
# Product build: in-app features only, no hosted-tier upsell.
UI_CLOUD_ENABLED=false
# openssl rand -base64 32
AUTH_SECRET=""
UI_GOOGLE_TAG_MANAGER_ID=""
NEXT_PUBLIC_PROWLER_RELEASE_VERSION=v5.45.0
# Release feed shown on the overview page. Leave empty to hide the widget.
RSS_FEED_SOURCES=''

#### Brand ####
# Read by the API and SDK brand modules. The UI brand lives in ui/cloudsneeker/brand.ts.
CLOUDSNEEKER_DOCS_URL=https://docs.cloudsneeker.example
CLOUDSNEEKER_SUPPORT_URL=https://support.cloudsneeker.example

#### MCP server ####
CLOUDSNEEKER_MCP_VERSION=stable
PROWLER_MCP_SERVER_URL=http://cloudsneeker-mcp:8000/mcp

#### API ####
CLOUDSNEEKER_API_VERSION="stable"
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=cloudsneeker_admin
POSTGRES_ADMIN_PASSWORD=""
POSTGRES_USER=cloudsneeker
POSTGRES_PASSWORD=""
POSTGRES_DB=cloudsneeker_db

NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=""
NEO4J_DBMS_MAX__DATABASES=1000
NEO4J_SERVER_MEMORY_PAGECACHE_SIZE=1G
NEO4J_SERVER_MEMORY_HEAP_INITIAL__SIZE=1G
NEO4J_SERVER_MEMORY_HEAP_MAX__SIZE=1G
NEO4J_PLUGINS=["apoc"]
NEO4J_DBMS_SECURITY_PROCEDURES_ALLOWLIST=apoc.*
NEO4J_DBMS_SECURITY_PROCEDURES_UNRESTRICTED=
NEO4J_APOC_EXPORT_FILE_ENABLED=false
NEO4J_APOC_IMPORT_FILE_ENABLED=false
NEO4J_APOC_IMPORT_FILE_USE_NEO4J_CONFIG=true
NEO4J_APOC_TRIGGER_ENABLED=false
NEO4J_DBMS_CONNECTOR_BOLT_LISTEN_ADDRESS=0.0.0.0:7687
ATTACK_PATHS_GRAPH_MUTATION_BATCH_SIZE=1000
ATTACK_PATHS_SERVICE_UNAVAILABLE_MAX_RETRIES=3
ATTACK_PATHS_READ_QUERY_TIMEOUT_SECONDS=30
ATTACK_PATHS_MAX_CUSTOM_QUERY_NODES=250

TASK_RETRY_DELAY_SECONDS=0.1
TASK_RETRY_ATTEMPTS=5

VALKEY_SCHEME=redis
VALKEY_USERNAME=
VALKEY_PASSWORD=
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_DB=0

DJANGO_TMP_OUTPUT_DIRECTORY="/tmp/prowler_api_output"
DJANGO_FINDINGS_BATCH_SIZE=1000
DJANGO_OUTPUT_S3_AWS_ACCESS_KEY_ID=""
DJANGO_OUTPUT_S3_AWS_SECRET_ACCESS_KEY=""
DJANGO_OUTPUT_S3_AWS_SESSION_TOKEN=""
DJANGO_OUTPUT_S3_AWS_DEFAULT_REGION=""
DJANGO_OUTPUT_S3_AWS_OUTPUT_BUCKET=""
DJANGO_OUTPUT_S3_AWS_ENDPOINT_URL=""
DJANGO_OUTPUT_S3_AWS_PUBLIC_ENDPOINT_URL=""

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,cloudsneeker-api
DJANGO_BIND_ADDRESS=0.0.0.0
DJANGO_PORT=8080
DJANGO_DEBUG=False
DJANGO_SETTINGS_MODULE=config.django.production
DJANGO_LOGGING_FORMATTER=human_readable
DJANGO_LOGGING_LEVEL=INFO
DJANGO_WORKERS=4
DJANGO_ACCESS_TOKEN_LIFETIME=30
DJANGO_REFRESH_TOKEN_LIFETIME=1440
DJANGO_CACHE_MAX_AGE=3600
DJANGO_STALE_WHILE_REVALIDATE=60
DJANGO_MANAGE_DB_PARTITIONS=True
# JWT claims that clients see when they decode a token.
DJANGO_JWT_ISSUER=https://api.cloudsneeker.example
DJANGO_JWT_AUDIENCE=https://api.cloudsneeker.example
# Public URL of the web app, used in Jira issue links.
DJANGO_UI_BASE_URL=${AUTH_URL}
# openssl genrsa -out private.pem 2048
DJANGO_TOKEN_SIGNING_KEY=""
# openssl rsa -in private.pem -pubout -out public.pem
DJANGO_TOKEN_VERIFYING_KEY=""
# openssl rand -base64 32
DJANGO_SECRETS_ENCRYPTION_KEY=""
DJANGO_BROKER_VISIBILITY_TIMEOUT=86400
DJANGO_SENTRY_DSN=
DJANGO_THROTTLE_TOKEN_OBTAIN=50/minute

UI_SENTRY_DSN=
UI_SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=local

#### Social login ####
SOCIAL_GOOGLE_OAUTH_CALLBACK_URL="${AUTH_URL}/api/auth/callback/google"
SOCIAL_GOOGLE_OAUTH_CLIENT_ID=""
SOCIAL_GOOGLE_OAUTH_CLIENT_SECRET=""
SOCIAL_GITHUB_OAUTH_CALLBACK_URL="${AUTH_URL}/api/auth/callback/github"
SOCIAL_GITHUB_OAUTH_CLIENT_ID=""
SOCIAL_GITHUB_OAUTH_CLIENT_SECRET=""
SAML_SSO_CALLBACK_URL="${AUTH_URL}/api/auth/callback/saml"

#### Lighthouse tracing ####
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGCHAIN_PROJECT=""
